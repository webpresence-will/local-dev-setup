#!/usr/bin/env bash

set -euo pipefail

SITE=$(basename "$PWD")
BASE_PATH="/var/www/html"

PHP_VERSION="8.5"

if [ -f ".php-version" ]; then
  PHP_VERSION=$(cat .php-version | tr -d '[:space:]')
fi

CONTAINER="php${PHP_VERSION/./}"

exec docker exec -it -w "$BASE_PATH/$SITE" "$CONTAINER" \
  sh -c 'if command -v bash >/dev/null 2>&1; then exec bash -l; else exec sh -l; fi'
