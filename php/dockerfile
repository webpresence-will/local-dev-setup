ARG PHP_VERSION=8.5

FROM php:${PHP_VERSION}-fpm

# Debian bullseye (PHP 7.4/8.0 images) has moved to archive.debian.org
RUN if grep -q bullseye /etc/os-release; then \
        sed -i 's|deb.debian.org|archive.debian.org|g' /etc/apt/sources.list; \
    fi

# System dependencies
RUN apt-get update && apt-get install -y \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libwebp-dev \
    libicu-dev \
    zip \
    unzip \
    curl \
    ca-certificates \
    gnupg \
    less \
    && rm -rf /var/lib/apt/lists/*

# Node.js
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Configure GD with JPEG, FreeType and WebP support
RUN docker-php-ext-configure gd \
    --with-freetype \
    --with-jpeg \
    --with-webp

# PHP extensions
RUN docker-php-ext-install \
    bcmath \
    mysqli \
    pdo_mysql \
    zip \
    intl \
    gd \
    sockets \
    pcntl

# Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# WP-CLI
RUN curl -fsSL https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
        -o /usr/local/bin/wp \
    && chmod +x /usr/local/bin/wp \
    && wp --info

# Developer user + writable Composer home
RUN useradd -m -u 1000 developer \
    && mkdir -p /home/developer/.composer/cache \
    && chown -R developer:developer /home/developer \
    && chown -R developer:developer /var/www

# Composer configuration
ENV COMPOSER_HOME=/home/developer/.composer

USER developer
